BOT_TOKEN=
# Application credentials from my.telegram.org/apps (one pair for the service).
API_ID=
API_HASH=
# Generated locally by python -m bot.init_secrets; keep stable across deploys.
SESSION_ENCRYPTION_KEY=
# HTTPS origin, e.g. https://tg-sender.onrender.com
# On Render RENDER_EXTERNAL_URL is used automatically if this is empty.
PUBLIC_BASE_URL=
# On Render set /var/data
DATA_DIR=./data
SEND_INTERVAL_SECONDS=5
PORT=10000
MAX_ACTIVE_USERS=50
MAX_CONCURRENT_SENDERS=3
